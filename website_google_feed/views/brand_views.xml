<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_product_action_all" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('google_product_brand_id', '=', active_id)]</field>
    </record>

    <!-- Merchant.brand -->
    <record id="product_merchant_brand_search_view" model="ir.ui.view">
        <field name="name">merchant.center.brand.search</field>
        <field name="model">merchant.center.brand</field>
        <field name="arch" type="xml">
            <search string="Product Brand">
                <field name="name" string="Product brand"/>
            </search>
        </field>
    </record>

    <record id="product_merchant_brand_form_view" model="ir.ui.view">
        <field name="name">merchant.center.brand.form</field>
        <field name="model">merchant.center.brand</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="website_publish_button" type="object" class="oe_stat_button" icon="fa-globe">
                            <field name="is_published" widget="website_publish_button"/>
                        </button>
                        <button class="oe_stat_button" name="%(product_product_action_all)d" type="action"
                                icon="fa-th-list">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="product_count"/>
                                </span>
                                <span class="o_stat_text">Products</span>
                            </div>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Brand name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Aligne"/>
                        </h1>
                    </div>
                    <div class="row o_website_sale_image_modal">
                        <div class="col-md-8 col-xl-7">
                            <label for="description"/>
                            <br/>
                            <field name="description"/>
                            <br/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_merchant_brand_list_view" model="ir.ui.view">
        <field name="name">merchant.center.brand.list</field>
        <field name="model">merchant.center.brand</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree string="Product Brand">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="product_merchant_brand_action_form" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">merchant.center.brand</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" eval="False"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Click to define a new brand.</p>
            <p>Brands are used to browse your products through the Google Merchant center.</p>
        </field>
    </record>

    <menuitem action="product_merchant_brand_action_form" id="menu_action_product_brand"
              parent="stock.menu_product_in_config_stock" sequence="5"/>

</odoo>