<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-inherit="account.TaxTotalsField" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-foreach='totals.subtotals']" position="before">
            <t t-if='totals.discounts'>
                <t t-foreach="totals.discounts" t-as="discount" t-key="discount_index" >
                    <tr>
                        <td class="o_td_label">
                            <label class="o_form_label o_tax_total_label" t-esc="discount['name']"/>
                        </td>

                        <td class="o_list_monetary">
                            <span t-att-name="discount['name']" style="white-space: nowrap; font-weight: bold;" t-out="discount['value']"/>
                        </td>
                    </tr>
                </t>
            </t>
        </xpath>
    </t>

</templates>
