<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="google_merchant_survey_scripts" inherit_id="website_sale.checkout_layout">
            <xpath expr="//div[@id='wrap']" position="after">
                <!-- BEGIN GCR Opt-in Module Code -->
                <t t-set="info_survey" t-value="website_sale_order._google_merchant_survey()"/>
                <script async="async" defer="defer" src="https://apis.google.com/js/platform.js?onload=renderOptIn"> </script>
                <script t-att-data-gcr-survey="json.dumps(info_survey)">
                    (function () {
                        const survey = JSON.parse(document.currentScript.dataset.gcrSurvey);
                        window.renderOptIn = function () {
                            window.gapi.load("surveyoptin", function () {
                                window.gapi.surveyoptin.render({
                                    ...survey,
                                    opt_in_style: "BOTTOM_LEFT_DIALOG",
                                });
                            });
                        };
                    })();
                </script>
                <!-- END GCR Opt-in Module Code -->

                <!-- BEGIN GCR Language Code -->
                <script>
                    window.___gcfg = {
                        lang: 'fr'
                    };
                </script>
                <!-- END GCR Language Code -->
            </xpath>
        </template>
    </data>

</odoo>
